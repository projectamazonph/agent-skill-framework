{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-skill-suite/handoff.schema.json",
  "title": "Agent Skill Suite Handoff Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "status",
    "scope_completed",
    "decisions",
    "evidence",
    "outputs",
    "risks",
    "next_skill",
    "next_action"
  ],
  "properties": {
    "skill": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": {
      "type": "string",
      "enum": ["ready", "active", "pass", "blocked", "needs-input", "not-applicable"]
    },
    "scope_completed": { "type": "string" },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "source", "result"],
        "properties": {
          "type": { "type": "string" },
          "source": { "type": "string" },
          "result": { "type": "string" }
        }
      }
    },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "next_skill": { "type": ["string", "null"] },
    "next_action": { "type": "string" }
  }
}
